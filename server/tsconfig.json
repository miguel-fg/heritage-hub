{
  "compilerOptions": {
    "moduleDetection": "force",
    "module": "Preserve",
    "target": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  }
}